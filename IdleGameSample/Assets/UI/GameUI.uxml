<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Packages/nl.kenney.uipack/UIPack/Styles.uss?fileID=7433441132597879392&amp;guid=6b2ba52b893135e4bbb95e1628538ea0&amp;type=3#Styles"/>
    <ui:TabView data-source-type="GameViewModel, Assembly-CSharp" class="blue button_rectangle_flat" style="justify-content: flex-start; align-content: flex-start; height: 100%;">
        <ui:Tab label="Game" style="height: auto;">
            <ui:VisualElement style="flex-grow: 1; height: 100%; flex-direction: row;">
                <ui:Label text="Score">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="Score" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; height: 100%; flex-direction: row;">
                <ui:Label text="Value">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="A" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
                <ui:Button text="Upgrade" name="Upgrade1" class="red button_rectangle_depth_gloss">
                    <Bindings>
                        <ui:DataBinding property="enabledSelf" data-source-path="CanUpgrade1" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; height: 100%; flex-direction: row;">
                <ui:Label text="Value">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="B" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
                <ui:Button text="Upgrade" name="Upgrade2" class="red button_rectangle_depth_gloss"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; height: 100%; flex-direction: row;">
                <ui:Label text="Value">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="P" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
                <ui:Button text="Upgrade" name="Upgrade3" class="red button_rectangle_depth_gloss"/>
            </ui:VisualElement>
        </ui:Tab>
        <ui:Tab label="Help">
            <ui:Label text="Some help text here...&#10;"/>
        </ui:Tab>
    </ui:TabView>
</ui:UXML>
